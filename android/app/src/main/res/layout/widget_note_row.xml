<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="4dp" android:paddingEnd="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row">
    <ImageButton android:id="@+id/widget_check" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/widget_checkbox_empty" android:contentDescription="Completar tarea" />
    <TextView android:id="@+id/widget_note_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_ink" />
</LinearLayout>
